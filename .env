# ============================================================================
# DREAMSADVERSTINGS — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env for local development. Never commit real secrets.
# ============================================================================

# Application
APP_NAME=DreamsAdverstings
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security & JWT
JWT_SECRET_KEY=REPLACE_WITH_64_BYTE_HEX_SECRET_IN_PRODUCTION
JWT_REFRESH_SECRET_KEY=REPLACE_WITH_64_BYTE_REFRESH_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dreamsadverstings.in

# PostgreSQL Database
POSTGRES_USER=dreams_user
POSTGRES_PASSWORD=dreams_local_dev_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dreamsadverstings_db
DATABASE_URL=postgresql+psycopg2://dreams_user:dreams_local_dev_pass@postgres:5432/dreamsadverstings_db

# Redis Cache & Distributed Booking Hold Coordinator
REDIS_URL=redis://redis:6379/0
BOOKING_HOLD_TTL_SECONDS=900

# AWS S3 (Presigned Media & Proof-of-Display Uploads)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET_NAME=dreamsadverstings-media-ap-south-1
AWS_S3_PRESIGNED_EXPIRY_SECONDS=600

# Razorpay Payment Gateway (Test Mode Default)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET
ENABLE_PARTIAL_PAYMENTS=false

# Maps Integration (Google Maps / Mapbox / ESRI ArcGIS Fallback)
NEXT_PUBLIC_MAP_PROVIDER=leaflet_arcgis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=REPLACE_WITH_MAPBOX_TOKEN

# Notification Channels (AWS SES / WhatsApp Business / SMS)
AWS_SES_SENDER_EMAIL=notifications@dreamsadverstings.in
WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v19.0/REPLACE_PHONE_NUMBER_ID/messages
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_WHATSAPP_BUSINESS_TOKEN
SMS_GATEWAY_API_KEY=REPLACE_WITH_SMS_GATEWAY_KEY

# AI Media Planner Assistant (Multi-Provider Configurable)
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
AI_MODEL_NAME=gemini-2.5-flash
